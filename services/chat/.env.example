# 模型凭证：一律走环境变量，不写进 YAML / 代码
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.amux.ai/v1

# PostgreSQL + pgvector（第五章持久化）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autix_chat?schema=public

# JWT：与 user-system 保持同一密钥，用于校验访问令牌
JWT_SECRET=replace-with-shared-secret

# 服务端口与跨域来源
PORT=4001
CORS_ORIGIN=http://localhost:3002
